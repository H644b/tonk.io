# Compose reads this file as .env. Set these in the process environment for bare Node.
HOST=127.0.0.1
PORT=3210
BONK_DATA_PATH=./data/bonk.sqlite
BONK_MODS_DIR=./mods
BONK_CURATORS=
# Host Caddy proxying to the loopback-only Docker port; never expose the app port publicly.
# Use the actual proxy IP/subnet if your network setup differs.
TRUST_PROXY=loopback,uniquelocal
# Set in Caddy's process environment (Compose does not configure host Caddy).
BONK_DOMAIN=game.example.com
# Durable storage for free hosts with disposable filesystems (e.g. Render Free).
# Use a Turso/libSQL database URL and token; never put the token in public files.
BONK_DATABASE_URL=
BONK_DATABASE_AUTH_TOKEN=
